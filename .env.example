# TypeSafe Jev (System One). Create a key in the TypeSafe console.
# TYPESAFE_API_KEY is what the SDK reads. JEV_API_KEY is an alias this repo accepts.
TYPESAFE_API_KEY=
JEV_API_KEY=

# Optional live LLM column. The demo stays on the stub until you pass --live-llm.
# A Jev key does not turn this on.
#
# Cursor Cloud Agents (no-repo). Use a crsr_ key. Slow (tens of seconds per ticket)
# and it spends agent usage. GROK_BOT_API_KEY wins over CURSOR_API_KEY when both are set.
GROK_BOT_API_KEY=
CURSOR_API_KEY=
#
# Or a normal OpenAI-compatible chat key. A value that starts with crsr_ is treated
# as a Cursor key, not as OpenAI. OPENAI_BASE_URL can point at any chat completions host.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
