# TypeSafe Jev (System One). Create a key in the TypeSafe console.
# TYPESAFE_API_KEY is what the SDK reads. JEV_API_KEY is an alias this repo accepts.
TYPESAFE_API_KEY=
JEV_API_KEY=

# Optional. The demo stays on the messy stub until you pass --live-llm.
# OPENAI_BASE_URL can point at any OpenAI-compatible chat completions endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
